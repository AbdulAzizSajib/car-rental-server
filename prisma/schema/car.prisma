model Car {
    id           String           @id @default(uuid(7))
    name         String
    brand        String
    model        String
    year         Int
    pricePerDay  Float
    seats        Int
    transmission TransmissionType
    fuelType     FuelType
    mileage      Float?

    hostId      String?
    isAvailable Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    host     HostProfile? @relation(fields: [hostId], references: [id])
    images   CarImage[]
    bookings Booking[]
    reviews  Review[]

    @@index([brand])
    @@index([pricePerDay])
    @@index([hostId])
}
