model Car {
    id           String           @id @default(uuid(7))
    name         String
    brandId      String
    modelId      String
    brand        Brand            @relation(fields: [brandId], references: [id])
    model        CarModel         @relation(fields: [modelId], references: [id])
    year         Int
    bodyType     BodyType // Missing in your schema
    pricePerDay  Float
    rentalType   RentalType       @default(ANY)
    seats        Int
    transmission TransmissionType
    fuelType     FuelType
    mileage      Float?

    // Bangladesh Market specific
    engineCapacity Int? // cc
    color          String?
    registrationNo String? @unique
    location       String // e.g., "Banani, Dhaka"
    isAC           Boolean @default(true)
    isWithDriver   Boolean @default(false)

    hostId      String?
    isAvailable Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    host     HostProfile? @relation(fields: [hostId], references: [id])
    images   CarImage[]
    bookings Booking[]
    reviews  Review[]

    @@index([brandId])
    @@index([modelId])
    @@index([pricePerDay])
    @@index([rentalType])
    @@index([hostId])
    @@index([location]) // Index for faster searching
}
