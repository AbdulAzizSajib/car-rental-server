model Car {
    id           String           @id @default(uuid(7))
    name         String
    brand        String
    model        String
    year         Int
    bodyType     BodyType // Missing in your schema
    pricePerDay  Float
    seats        Int
    transmission TransmissionType
    fuelType     FuelType
    mileage      Float?

    // Bangladesh Market specific
    engineCapacity Int? // cc
    color          String?
    registrationNo String? @unique
    location       String // e.g., "Banani, Dhaka"
    isAC           Boolean @default(true)
    isWithDriver   Boolean @default(false)

    hostId      String?
    isAvailable Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    host     HostProfile? @relation(fields: [hostId], references: [id])
    images   CarImage[]
    bookings Booking[]
    reviews  Review[]

    @@index([brand])
    @@index([pricePerDay])
    @@index([hostId])
    @@index([location]) // Index for faster searching
}
