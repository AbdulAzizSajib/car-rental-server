model Coupon {
    id            String       @id @default(uuid(7))
    code          String       @unique
    discountType  DiscountType
    discountValue Float
    minAmount     Float?
    maxUses       Int?
    usedCount     Int          @default(0)
    expiresAt     DateTime?
    isActive      Boolean      @default(true)

    createdAt DateTime @default(now())
}
