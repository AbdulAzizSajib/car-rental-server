            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cars?page=1&limit=10&search=toyota&brandId=<brand-uuid>&modelId=<model-uuid>&bodyTypeId=<body-type-uuid>&fuelTypeId=<fuel-type-uuid>&transmission=AUTOMATIC&rentalType=PER_DAY&priceFrom=3000&priceTo=8000&isAvailable=true&sortBy=pricePerDay&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["cars"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "toyota", "disabled": true },
                { "key": "brandId", "value": "<brand-uuid>", "disabled": true },
                { "key": "modelId", "value": "<model-uuid>", "disabled": true },
                { "key": "bodyTypeId", "value": "<body-type-uuid>", "disabled": true },
