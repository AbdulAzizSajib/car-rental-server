{
  "info": {
    "name": "Car Rental API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/verify-email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/resend-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Forget Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forget-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newpassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/create-admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/me",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Name", "type": "text" },
                { "key": "profilePhoto", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cars",
      "item": [
        {
          "name": "Get All Cars",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cars?page=1&limit=10&search=toyota&brand=Toyota&fuelType=PETROL&transmission=AUTOMATIC&isAvailable=true&sortBy=pricePerDay&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["cars"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "toyota", "disabled": true },
                { "key": "brand", "value": "Toyota", "disabled": true },
                { "key": "fuelType", "value": "PETROL", "disabled": true },
                { "key": "transmission", "value": "AUTOMATIC", "disabled": true },
                { "key": "isAvailable", "value": "true", "disabled": true },
                { "key": "sortBy", "value": "pricePerDay", "disabled": true },
                { "key": "sortOrder", "value": "asc", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Car (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/cars/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Corolla 2022\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"year\": 2022,\n  \"pricePerDay\": 50,\n  \"seats\": 5,\n  \"transmission\": \"AUTOMATIC\",\n  \"fuelType\": \"PETROL\",\n  \"mileage\": 15000,\n  \"isAvailable\": true\n}"
            }
          }
        },
        {
          "name": "Update Car (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/cars/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerDay\": 60,\n  \"isAvailable\": true\n}"
            }
          }
        },
        {
          "name": "Delete Car (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/cars/:id"
          }
        },
        {
          "name": "Upload Car Images (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/cars/:id/images",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "images", "type": "file", "src": "" },
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Delete Car Image (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/cars/images/:imageId"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (User)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": \"<car-uuid>\",\n  \"pickupLocation\": \"Dhaka Airport\",\n  \"dropLocation\": \"Chittagong\",\n  \"startDate\": \"2026-05-01\",\n  \"endDate\": \"2026-05-05\"\n}"
            }
          }
        },
        {
          "name": "My Bookings (User)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings/my?page=1&limit=10&status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Booking",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/:id"
          }
        },
        {
          "name": "Cancel Booking (User)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/bookings/:id/cancel"
          }
        },
        {
          "name": "Get All Bookings (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings?page=1&limit=10&status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Update Booking Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/bookings/:id/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            }
          }
        },
        {
          "name": "Assign Driver (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/bookings/:id/assign-driver",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"<driver-uuid>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment (User)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"<booking-uuid>\",\n  \"method\": \"stripe\",\n  \"transactionId\": \"txn_123\"\n}"
            }
          }
        },
        {
          "name": "My Payments (User)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/my?page=1&limit=10&status=PAID",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PAID", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Payment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/:id"
          }
        },
        {
          "name": "Get All Payments (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments?page=1&limit=10&status=PAID",
              "host": ["{{baseUrl}}"],
              "path": ["payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PAID", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Update Payment Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/payments/:id/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\",\n  \"transactionId\": \"txn_abc123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Drivers",
      "item": [
        {
          "name": "Get All Drivers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/drivers?page=1&limit=10&isAvailable=true",
              "host": ["{{baseUrl}}"],
              "path": ["drivers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "isAvailable", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Driver",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/drivers/:id"
          }
        },
        {
          "name": "Create Driver (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/drivers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"<user-uuid>\",\n  \"licenseNo\": \"DL-12345678\"\n}"
            }
          }
        },
        {
          "name": "Update Driver (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/drivers/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licenseNo\": \"DL-99999999\",\n  \"isAvailable\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Get Car Reviews",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/reviews?carId=<car-uuid>&page=1&limit=10&sortBy=rating&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"],
              "query": [
                { "key": "carId", "value": "<car-uuid>" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "rating", "disabled": true },
                { "key": "sortOrder", "value": "desc", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Add Review (User)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": \"<car-uuid>\",\n  \"rating\": 5,\n  \"comment\": \"Excellent car, very comfortable!\"\n}"
            }
          }
        },
        {
          "name": "Delete Review (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/reviews/:id"
          }
        }
      ]
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "Create Coupon (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/coupons",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE20\",\n  \"discountType\": \"PERCENTAGE\",\n  \"discountValue\": 20,\n  \"minAmount\": 100,\n  \"maxUses\": 50,\n  \"expiresAt\": \"2026-12-31\"\n}"
            }
          }
        },
        {
          "name": "Get All Coupons (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/coupons?page=1&limit=10&isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["coupons"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Apply Coupon (User)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/coupons/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE20\",\n  \"bookingAmount\": 250\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard/summary"
          }
        },
        {
          "name": "Recent Bookings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard/recent-bookings"
          }
        },
        {
          "name": "Booking Status Count",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard/booking-status-count"
          }
        }
      ]
    }
  ]
}
